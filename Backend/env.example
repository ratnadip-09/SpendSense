# ── Server ──────────────────────────────────────────
PORT=5000

# ── MongoDB ─────────────────────────────────────────
# Local:  mongodb://localhost:27017/spendsense
# Atlas:  mongodb+srv://<user>:<password>@cluster.mongodb.net/spendsense
MONGO_URI=mongodb://localhost:27017/spendsense

# ── JWT ─────────────────────────────────────────────
JWT_SECRET=replace_this_with_a_long_random_secret
JWT_EXPIRES_IN=7d

# ── Client origin (for CORS) ─────────────────────────
CLIENT_URL=http://localhost:5173

# ── Google Sign-In ────────────────────────────────────
# OAuth 2.0 Client ID from https://console.cloud.google.com/apis/credentials
# Must match VITE_GOOGLE_CLIENT_ID in Frontend/.env
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
